<?xml version="1.0"?>
<robot name="drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="common_properties.xacro" />
  <xacro:include filename="drone_gazebo.xacro" />
  <xacro:include filename="imu_sensor.xacro" />

  <xacro:property name="base_length" value="0.15" />
  <xacro:property name="base_width" value="0.15" />
  <xacro:property name="base_height" value="0.05" />

  <xacro:property name="arm_length" value="0.15" />
  <xacro:property name="arm_width" value="0.015" />
  <xacro:property name="arm_height" value="0.015" />

  <xacro:property name="shaft_radius" value="0.002" />
  <xacro:property name="shaft_length" value="0.02" />

  <xacro:property name="propeller_radius" value="0.06" />
  <xacro:property name="propeller_length" value="0.004" />

  <xacro:property name="stand_radius" value="0.01" />
  <xacro:property name="stand_length" value="0.1" />

  <link name="base_footprint" />

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.3" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>

  <link name="front_right_arm_link" >
    <visual>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
    </collision>
    <xacro:box_inertia m="0.025" x="${arm_length}" y="${arm_width}" z="${arm_height}" o_xyz="${arm_length/2.0} 0 0" o_rpy="0 0 0" />
  </link>

  <link name="front_left_arm_link" >
    <visual>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
    </collision>
    <xacro:box_inertia m="0.025" x="${arm_length}" y="${arm_width}" z="${arm_height}" o_xyz="${arm_length/2.0} 0 0" o_rpy="0 0 0" />
  </link>

  <link name="back_right_arm_link" >
    <visual>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
    </collision>
    <xacro:box_inertia m="0.025" x="${arm_length}" y="${arm_width}" z="${arm_height}" o_xyz="${arm_length/2.0} 0 0" o_rpy="0 0 0" />
  </link>

  <link name="back_left_arm_link" >
    <visual>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${arm_length} ${arm_width} ${arm_height}" />
      </geometry>
      <origin xyz="${arm_length/2.0} 0 0" rpy="0 0 0" />
    </collision>
    <xacro:box_inertia m="0.025" x="${arm_length}" y="${arm_width}" z="${arm_height}" o_xyz="${arm_length/2.0} 0 0" o_rpy="0 0 0" />
  </link>

  <link name="front_right_shaft_link" >
    <visual>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.03" r="${shaft_radius}" l="${shaft_length}" o_xyz="0 0 ${shaft_length/2.0}" o_rpy="0 0 0" />
  </link>

  <link name="front_left_shaft_link" >
    <visual>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.03" r="${shaft_radius}" l="${shaft_length}" o_xyz="0 0 ${shaft_length/2.0}" o_rpy="0 0 0" />
  </link>

  <link name="back_right_shaft_link" >
    <visual>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.03" r="${shaft_radius}" l="${shaft_length}" o_xyz="0 0 ${shaft_length/2.0}" o_rpy="0 0 0" />
  </link>

  <link name="back_left_shaft_link" >
    <visual>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${shaft_radius}" length="${shaft_length}" />
      </geometry>
      <origin xyz="0 0 ${shaft_length/2.0}" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.03" r="${shaft_radius}" l="${shaft_length}" o_xyz="0 0 ${shaft_length/2.0}" o_rpy="0 0 0" />
  </link>

  <link name="front_right_propeller_link" >
    <visual>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.006" r="${propeller_radius}" l="${propeller_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>

  <link name="front_left_propeller_link" >
    <visual>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.006" r="${propeller_radius}" l="${propeller_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>

  <link name="back_right_propeller_link" >
    <visual>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.006" r="${propeller_radius}" l="${propeller_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>

  <link name="back_left_propeller_link" >
    <visual>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${propeller_radius}" length="${propeller_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.006" r="${propeller_radius}" l="${propeller_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>

  <link name="right_stand_link">
    <visual>
      <geometry>
        <cylinder radius="${stand_radius}" length="${stand_length}" />
      </geometry>
      <origin xyz="0 0 ${-stand_length/2.0}" rpy="0 0 0" />
      <material name="yellow" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${stand_radius}" length="${stand_length}" />
      </geometry>
      <origin xyz="0 0 ${-stand_length/2.0}" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.015" r="${stand_radius}" l="${stand_length}" o_xyz="0 0 ${-stand_length/2.0}" o_rpy="0 0 0" />
  </link>

  <link name="left_stand_link">
    <visual>
      <geometry>
        <cylinder radius="${stand_radius}" length="${stand_length}" />
      </geometry>
      <origin xyz="0 0 ${-stand_length/2.0}" rpy="0 0 0" />
      <material name="yellow" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${stand_radius}" length="${stand_length}" />
      </geometry>
      <origin xyz="0 0 ${-stand_length/2.0}" rpy="0 0 0" />
    </collision>
    <xacro:cylinder_inertia m="0.015" r="${stand_radius}" l="${stand_length}" o_xyz="0 0 ${-stand_length/2.0}" o_rpy="0 0 0" />
  </link>

  <link name="right_stand_base_link">
    <visual>
      <geometry>
        <cylinder radius="${stand_radius}" length="${base_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 ${-pi/2.0} 0" />
      <material name="black" />
    </visual>
    <collision> 
      <geometry>
        <cylinder radius="${stand_radius}" length="${base_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 ${-pi/2.0} 0" />
    </collision>
    <xacro:cylinder_inertia m="0.01" r="${stand_radius}" l="${base_length}" o_xyz="0 0 0" o_rpy="0 ${-pi/2.0} 0" />
  </link>

  <link name="left_stand_base_link">
    <visual>
      <geometry>
        <cylinder radius="${stand_radius}" length="${base_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 ${-pi/2.0} 0" />
      <material name="black" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${stand_radius}" length="${base_length}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 ${-pi/2.0} 0" />
    </collision>
    <xacro:cylinder_inertia m="0.01" r="${stand_radius}" l="${base_length}" o_xyz="0 0 0" o_rpy="0 ${-pi/2.0} 0" />
  </link>


  
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${(base_height/2.0)+(stand_length)+(stand_radius/2.0)}" rpy="0 0 0" />
  </joint>

  <joint name="base_front_right_arm_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_right_arm_link" />
    <origin xyz="${base_length/2.0} ${base_width/2.0} 0" rpy="0 0 ${pi/4.0}" />
  </joint>

  <joint name="base_front_left_arm_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_left_arm_link" />
    <origin xyz="${base_length/2.0} ${-base_width/2.0} 0" rpy="0 0 ${-pi/4.0}" />
  </joint>
  
  <joint name="base_back_right_arm_joint" type="fixed">
    <parent link="base_link" />
    <child link="back_right_arm_link" />
    <origin xyz="${-base_length/2.0} ${base_width/2.0} 0" rpy="0 0 ${3.0*pi/4.0}" />
  </joint>

  <joint name="base_back_left_arm_joint" type="fixed">
    <parent link="base_link" />
    <child link="back_left_arm_link" />
    <origin xyz="${-base_length/2.0} ${-base_width/2.0} 0" rpy="0 0 ${-3.0*pi/4.0}" />
  </joint>

  <joint name="front_right_arm_shaft_joint" type="fixed">
    <parent link="front_right_arm_link" />
    <child link="front_right_shaft_link" />
    <origin xyz="${9*arm_length/10.0} 0 ${arm_height/2.0}" rpy="0 0 0" />
  </joint>

  <joint name="front_left_arm_shaft_joint" type="fixed">
    <parent link="front_left_arm_link" />
    <child link="front_left_shaft_link" />
    <origin xyz="${9*arm_length/10.0} 0 ${arm_height/2.0}" rpy="0 0 0" />
  </joint>

  <joint name="back_right_arm_shaft_joint" type="fixed">
    <parent link="back_right_arm_link" />
    <child link="back_right_shaft_link" />
    <origin xyz="${9*arm_length/10.0} 0 ${arm_height/2.0}" rpy="0 0 0" />
  </joint>

  <joint name="back_left_arm_shaft_joint" type="fixed">
    <parent link="back_left_arm_link" />
    <child link="back_left_shaft_link" />
    <origin xyz="${9*arm_length/10.0} 0 ${arm_height/2.0}" rpy="0 0 0" />
  </joint>

  <joint name="front_right_shaft_propeller" type="continuous">
    <parent link="front_right_shaft_link" />
    <child link="front_right_propeller_link" />
    <origin xyz="0 0 ${shaft_length}"  rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="front_left_shaft_propeller" type="continuous">
    <parent link="front_left_shaft_link" />
    <child link="front_left_propeller_link" />
    <origin xyz="0 0 ${shaft_length}"  rpy="0 0 0" />
    <axis xyz="0 0 -1" />
  </joint>

  <joint name="back_right_shaft_propeller" type="continuous">
    <parent link="back_right_shaft_link" />
    <child link="back_right_propeller_link" />
    <origin xyz="0 0 ${shaft_length}"  rpy="0 0 0" />
    <axis xyz="0 0 -1" />
  </joint>

  <joint name="back_left_shaft_propeller" type="continuous">
    <parent link="back_left_shaft_link" />
    <child link="back_left_propeller_link" />
    <origin xyz="0 0 ${shaft_length}"  rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="base_right_stand_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_stand_link" />
    <origin xyz="0 ${-base_width/3.0} ${-base_height/2.0}" rpy="${-pi/12.0} 0 0" />
  </joint>

  <joint name="base_left_stand_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_stand_link" />
    <origin xyz="0 ${base_width/3.0} ${-base_height/2.0}" rpy="${pi/12.0} 0 0" />
  </joint>

  <joint name="right_stand_base_joint" type="fixed">
    <parent link="right_stand_link" />
    <child link="right_stand_base_link" />
    <origin xyz="0 0 ${-stand_length}" rpy="0 0 0" />
  </joint>

  <joint name="left_stand_base_joint" type="fixed">
    <parent link="left_stand_link" />
    <child link="left_stand_base_link" />
    <origin xyz="0 0 ${-stand_length}" rpy="0 0 0" />
  </joint>

</robot>